# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: restrict webhook to this secret token
TELEGRAM_WEBHOOK_SECRET=

# Application environment: prod, dev
APP_ENV=prod

# Log level: debug, info, warning, error
LOG_LEVEL=info

# GitHub repository URL shown in About section
GITHUB_REPO=https://github.com/yourusername/SpaceWeatherBot

# Developer name shown in About section
DEVELOPER_NAME=Maxim

# Default locale for new users: en or ru
DEFAULT_LOCALE=en

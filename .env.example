# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: restrict webhook to this secret token
TELEGRAM_WEBHOOK_SECRET=

# Application environment: prod, dev
APP_ENV=prod

# Log level: debug, info, warning, error
LOG_LEVEL=info

# GitHub repository URL shown in About section
GITHUB_REPO=https://github.com/yourusername/SpaceWeatherBot

# Developer name shown in About section
DEVELOPER_NAME=Maxim

# Default locale for new users: en or ru
DEFAULT_LOCALE=en

# Location shown on the "Weather" screen. Defaults to Ostankino, Moscow -
# the practical geographic center of the North-Eastern Administrative Okrug (SVAO).
WEATHER_LAT=55.8197
WEATHER_LON=37.6117
WEATHER_LOCATION_NAME=Moscow, NE (Ostankino)

# Optional: enables the OpenWeatherMap reading alongside Open-Meteo (which needs
# no key) on the Weather screen. Get a free key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
